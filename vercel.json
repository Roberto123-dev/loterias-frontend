{
  "version": 2,
  "buildCommand": "echo 'No build needed'",
  "outputDirectory": "public",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    { "source": "/login",                 "destination": "/auth/login",                   "permanent": true },
    { "source": "/registro",              "destination": "/auth/registro",                "permanent": true },
    { "source": "/forgot-password",       "destination": "/auth/forgot-password",         "permanent": true },
    { "source": "/reset-password",        "destination": "/auth/reset-password",          "permanent": true },
    { "source": "/perfilusuario",         "destination": "/auth/perfilusuario",           "permanent": true },
    { "source": "/megasena",              "destination": "/loterias/megasena",            "permanent": true },
    { "source": "/lotofacil",             "destination": "/loterias/lotofacil",           "permanent": true },
    { "source": "/quina",                 "destination": "/loterias/quina",               "permanent": true },
    { "source": "/timemania",             "destination": "/loterias/timemania",           "permanent": true },
    { "source": "/diadasorte",            "destination": "/loterias/diadasorte",          "permanent": true },
    { "source": "/duplasena",             "destination": "/loterias/duplasena",           "permanent": true },
    { "source": "/lotomania",             "destination": "/loterias/lotomania",           "permanent": true },
    { "source": "/maismilionaria",        "destination": "/loterias/maismilionaria",      "permanent": true },
    { "source": "/resultado",             "destination": "/analise/resultado",            "permanent": true },
    { "source": "/resultado-combinacoes", "destination": "/analise/resultado-combinacoes","permanent": true },
    { "source": "/conferir",              "destination": "/analise/conferir",             "permanent": true },
    { "source": "/estatisticas",          "destination": "/analise/estatisticas",         "permanent": true },
    { "source": "/analise-dezenas",       "destination": "/analise/analise-dezenas",      "permanent": true },
    { "source": "/analise-combinacoes",   "destination": "/analise/analise-combinacoes",  "permanent": true },
    { "source": "/mapa-dezenas",          "destination": "/analise/mapa-dezenas",         "permanent": true },
    { "source": "/gerador-combinacoes",   "destination": "/ferramentas/gerador-combinacoes", "permanent": true },
    { "source": "/ciclo-dezenas",         "destination": "/ferramentas/ciclo-dezenas",    "permanent": true },
    { "source": "/gerenciar-grupos",      "destination": "/grupos/gerenciar-grupos",      "permanent": true },
    { "source": "/meus-jogos",            "destination": "/jogos/meus-jogos",             "permanent": true }
  ],
  "headers": [
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*\\.png|.*\\.webmanifest)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, must-revalidate"
        }
      ]
    }
  ]
}
